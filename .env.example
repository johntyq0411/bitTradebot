# =============================================================================
# .env.example — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git — it is already in .gitignore.
#
# Usage on VPS:
#   cp .env.example .env
#   nano .env   # fill in your secrets
#   docker compose up -d
# =============================================================================

# ── Freqtrade REST API ────────────────────────────────────────────────────────
FREQUI_USERNAME=freqtrader
FREQUI_PASSWORD=change_me_strong_password
FREQUI_JWT_SECRET=change_me_to_random_64char_string

# ── Exchange API Keys ─────────────────────────────────────────────────────────
# Paper trading (dry_run=true): keys are optional but must be set to non-empty
# Live trading (dry_run=false): keys MUST be valid read+trade API keys
BINANCEUS_API_KEY=your_binanceus_api_key_here
BINANCEUS_API_SECRET=your_binanceus_api_secret_here

# ── Discord Webhook (hermes_monitor.sh) ───────────────────────────────────────
# Create a webhook in your Discord server:
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Factor Collector ──────────────────────────────────────────────────────────
# Override data directory for Docker sidecar (leave empty for host-native run)
# FACTOR_DATA_DIR=/freqtrade/user_data/data/external
