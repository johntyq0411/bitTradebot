# Git ignore for Freqtrade paper-trading bot project

# ── Freqtrade generated files ──────────────────────────────────────────────
user_data/logs/*.log
user_data/logs/backtest_output.txt
user_data/backtest_results/*.json
user_data/backtest_results/*.pkl
user_data/data/

# ── Freqtrade live database (contains trade history, never commit) ──────────
tradesv3.dryrun.sqlite
tradesv3.dryrun.sqlite-shm
tradesv3.dryrun.sqlite-wal
tradesv3.sqlite
tradesv3.sqlite-shm
tradesv3.sqlite-wal

# ── Live config (contains API keys — only example is safe to commit) ────────
user_data/config.json

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Local config (host-relative paths, not for version control) ────────────
user_data/config_local.json

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editors ────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Secrets & environment files ─────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.json

# ── Monitor logs ─────────────────────────────────────────────────────────────
monitor.log
nohup.out
user_data/models/
user_data/backtest_results/*.zip
